# Copy to .env and fill in values. Never commit the real .env file.

META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_GRAPH_API_BASE_URL=
META_API_VERSION=

# OpenAI — backend only. Never expose this key to React, VITE_*, or NEXT_PUBLIC_*.
# Never store the key in the database. Never return it through an API.
OPENAI_API_KEY=

# DeepSeek — backend only. Never expose this key to React, VITE_*, or NEXT_PUBLIC_*.
# Never store the key in the database. Never return it through an API.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

LLM_PROVIDER=openai
LLM_MODEL=<configured-model>
VISION_PROVIDER=deepseek

IMAGE_PROVIDER=openai
IMAGE_MODEL=<configured-image-model>

# Content Agent image provider. The model name is configuration, not a price.
# Default creative size is 1024x1024 unless OPENAI_IMAGE_SIZE or IMAGE_SIZE overrides it.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_QUALITY=high
# OPENAI_IMAGE_OUTPUT_FORMAT=png

# Auth / database
# SQLite locally (default file if empty: data/agentic.db). PostgreSQL later:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agentic
DATABASE_URL=sqlite:///./data/agentic.db
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
JWT_COOKIE_SECURE=false
TOKEN_ENCRYPTION_KEY=
# Bootstrap admin is created from these env vars only. Never hard-code them in app logic.
# The admin must change this password after the first successful login.
DEFAULT_ADMIN_EMAIL=admin@yottolabs.com
DEFAULT_ADMIN_PASSWORD=12345
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
SCHEDULER_ENABLED=false
DEFAULT_TIMEZONE=Asia/Kolkata

# Canva MCP is optional. Leave CANVA_ENABLED unset and DeepSeek / OpenAI image
# generation keep working. Do not put these values in the React app.
# Setup: https://www.canva.dev/docs/mcp/ — register a redirect URI, then either
# create a Developer Portal app (client id + secret) or use a CIMD client id URL.
# CANVA_ENABLED=false
# CANVA_MCP_URL=https://mcp.canva.com/mcp
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
# CANVA_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/canva/callback
# CANVA_TIMEOUT_SECONDS=60
# TOKEN_ENCRYPTION_KEY is required before any user connects Canva.

# Optional
# IMAGE_PUBLIC_BASE_URL=https://your-public-https-host.example
# MAX_IMAGE_SIZE_MB=8
# REQUEST_TIMEOUT_SECONDS=30
# LOG_LEVEL=INFO
