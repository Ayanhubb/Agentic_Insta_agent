# Copy to .env and fill in values. Never commit the real .env file.

META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_GRAPH_API_BASE_URL=
META_API_VERSION=

# OpenAI — backend only. Never expose this key to React, VITE_*, or NEXT_PUBLIC_*.
# Never store the key in the database. Never return it through an API.
OPENAI_API_KEY=

LLM_PROVIDER=openai
LLM_MODEL=<configured-model>

IMAGE_PROVIDER=openai
IMAGE_MODEL=<configured-image-model>

# Auth / database
# SQLite locally (default file if empty: data/agentic.db). PostgreSQL later:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agentic
DATABASE_URL=sqlite:///./data/agentic.db
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
JWT_COOKIE_SECURE=false
TOKEN_ENCRYPTION_KEY=
# Bootstrap admin is created from these env vars only. Never hard-code them in app logic.
# The admin must change this password after the first successful login.
DEFAULT_ADMIN_EMAIL=admin@yottolabs.com
DEFAULT_ADMIN_PASSWORD=12345
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
SCHEDULER_ENABLED=false
DEFAULT_TIMEZONE=Asia/Kolkata

# Optional
# IMAGE_PUBLIC_BASE_URL=https://your-public-https-host.example
# MAX_IMAGE_SIZE_MB=8
# REQUEST_TIMEOUT_SECONDS=30
# LOG_LEVEL=INFO
